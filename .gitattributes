* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
LICENSE text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.step binary
*.stl binary
*.FCStd binary

# Frozen netlists retain the exact bytes used by the historical simulation.
hardware/simulation/brake/inputs/*.xml -text
# Simulation evidence has byte-level hashes; preserve it across Windows checkouts.
hardware/simulation/brake/results/** -text
hardware/simulation/brake/RESULTS.md -text
hardware/simulation/brake/model-checks/*.log -text

# Current release manifests hash exact PCB and fabrication-file bytes.
hardware/two-layer/encoder/Encoder.kicad_pcb -text whitespace=cr-at-eol
hardware/two-layer/sandwich/lower/Lower.kicad_pcb -text whitespace=cr-at-eol
hardware/two-layer/sandwich/upper/Upper.kicad_pcb -text whitespace=cr-at-eol
hardware/two-layer/sandwich/wheel/Wheel.kicad_pcb -text whitespace=cr-at-eol
hardware/two-layer/sandwich/panel/Panel.kicad_pcb -text whitespace=cr-at-eol
hardware/two-layer/sandwich/quote-package/** -text whitespace=cr-at-eol
