* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
LICENSE text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.step binary
*.stl binary
*.FCStd binary

# Preserve the exact bytes covered by bench CAD and package SHA-256 evidence.
hardware/modular/main/Main.kicad_pcb -text
hardware/modular/wheel/Wheel.kicad_pcb -text
hardware/encoder/Encoder.kicad_pcb -text
hardware/bench/Panel.kicad_pcb -text
hardware/bench/package/** -text
# Simulation evidence has byte-level hashes; preserve it across Windows checkouts.
hardware/simulation/brake/results/** -text
hardware/simulation/brake/RESULTS.md -text
hardware/simulation/brake/model-checks/*.log -text
